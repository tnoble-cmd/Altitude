<main class="page-shell">
  <section class="panel">
    <div class="panel__heading">
      <p class="eyebrow">Our Story</p>
      <h2>About Us</h2>
    </div>

    <p class="page-copy">
      Altitude Tech Systems partners with growing businesses to build practical technology systems that simplify operations, strengthen customer experiences, and support long-term growth.
    </p>

    <div class="card-grid">
      <article class="card">
        <h3>Strategy</h3>
        <p>We align technology decisions with your operational goals and priorities.</p>
      </article>
      <article class="card">
        <h3>Execution</h3>
        <p>We turn ideas into dependable solutions that deliver measurable value.</p>
      </article>
      <article class="card">
        <h3>Support</h3>
        <p>We stay close to your team to keep systems running smoothly after launch.</p>
      </article>
    </div>

    <div class="actions" style="margin-top: 2rem; justify-content: center;">
      <%= link_to "Back to Home", root_path, class: "button secondary" %>
      <%= link_to "See Projects", projects_path, class: "button primary" %>
    </div>
  </section>
</main>
