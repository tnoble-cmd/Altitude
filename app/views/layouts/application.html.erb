<!DOCTYPE html>
<html>
  <head>
    <title>BasicSite</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="site-shell">
      <header class="site-header">
        <%= image_tag "altitude-tech-systems-banner.png", alt: "Altitude Tech Systems banner", class: "brand-banner" %>
      </header>

      <nav class="site-nav" aria-label="Main navigation">
        <%= link_to "Home", root_path, class: "nav-link #{"active" if current_page?(root_path)}" %>
        <%= link_to "About Us", about_us_path, class: "nav-link #{"active" if current_page?(about_us_path)}" %>
        <%= link_to "Projects", projects_path, class: "nav-link #{"active" if current_page?(projects_path)}" %>
        <%= link_to "Contact", contact_path, class: "nav-link #{"active" if current_page?(contact_path)}" %>
      </nav>

      <%= yield %>
    </div>
  </body>
</html>
