<main class="page-shell projects-page">
  <section class="panel projects-panel">
    <div class="panel__heading">
      <p class="eyebrow">Featured Work</p>
      <h2>Projects</h2>
    </div>

    <p class="page-copy project-intro">
      Our projects focus on efficiency, visibility, and professional systems that help teams move faster with confidence.
    </p>

    <div class="project-showcase" aria-label="Project gallery">
      <article class="project-card project-card--large">
        <div class="project-image project-image--one" aria-label="Project placeholder image"></div>
        <div class="project-copy">
          <span class="project-tag">Infrastructure</span>
          <h3>IT Infrastructure Solutions</h3>
          <p>Comprehensive IT infrastructure design, and implementation from rough-in, to final deployment.</p>
        </div>
      </article>

      <article class="project-card">
        <div class="project-image project-image--two" aria-label="Project placeholder image"></div>
        <div class="project-copy">
          <span class="project-tag">Networking</span>
          <h3>Network Architecture Design and Implementation</h3>
          <p>Set up and deployment of your network infrastructure.</p>
        </div>
      </article>

      <article class="project-card">
        <div class="project-image project-image--three" aria-label="Project placeholder image"></div>
        <div class="project-copy">
          <span class="project-tag">Office Setup</span>
          <h3>Office Setup and Configuration</h3>
          <p>Comprehensive office setup and configuration services to get your team up and running efficiently.</p>
        </div>
      </article>

      <article class="project-card">
        <div class="project-image project-image--four" aria-label="Project placeholder image"></div>
        <div class="project-copy">
          <span class="project-tag">Troubleshooting</span>
          <h3>Technical Support and Troubleshooting</h3>
          <p>Comprehensive technical support and troubleshooting services to keep your systems running smoothly.</p>
        </div>
      </article>
    </div>

    <div class="actions" style="margin-top: 2rem; justify-content: center;">
      <%= link_to "Back to Home", root_path, class: "button secondary" %>
      <%= link_to "About Us", about_us_path, class: "button primary" %>
    </div>
  </section>
</main>
